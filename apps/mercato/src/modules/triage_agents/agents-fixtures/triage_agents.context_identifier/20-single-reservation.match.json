{
  "match": {
    "tools.tickets.get_ticket.ticket.subject": { "not": { "matches": "\\b[A-Z]{3}[0-9]{3}\\b" } },
    "tools.reservations.list_for_customer.reservations.length": 1
  },
  "steps": [
    { "toolCalls": [{ "toolName": "tickets.get_ticket", "input": { "ticketId": "{{input.ticketId}}" } }] },
    {
      "toolCalls": [
        { "toolName": "reservations.list_for_customer", "input": { "email": "{{tools.tickets.get_ticket.ticket.requesterEmail}}" } }
      ]
    }
  ],
  "object": {
    "kind": "research",
    "data": {
      "customer": { "personId": "{{tools.reservations.list_for_customer.customerPersonId}}", "match": "confirmed" },
      "reservation": {
        "reservationId": "{{tools.reservations.list_for_customer.reservations.0.id}}",
        "bookingNumber": "{{tools.reservations.list_for_customer.reservations.0.bookingNumber}}",
        "match": "single_reservation",
        "candidates": [],
        "departureDate": "{{tools.reservations.list_for_customer.reservations.0.departureDate}}",
        "daysToDeparture": "{{tools.reservations.list_for_customer.reservations.0.daysToDeparture}}"
      },
      "evidence": [
        { "source": "crm", "quote": "The sender has exactly one reservation: {{tools.reservations.list_for_customer.reservations.0.bookingNumber}} ({{tools.reservations.list_for_customer.reservations.0.destination}})." }
      ],
      "uncertainty": [],
      "confidence": 0.9
    }
  },
  "usage": { "inputTokens": 1320, "outputTokens": 190 }
}
