            "label": "{{tools.reservations.list_for_customer.reservations.1.destination}}, {{tools.reservations.list_for_customer.reservations.1.hotelName}}",
            "daysToDeparture": "{{tools.reservations.list_for_customer.reservations.1.daysToDeparture}}"
          }
        ],
        "departureDate": null,
        "daysToDeparture": null
      },
      "evidence": [
        { "source": "crm", "quote": "The sender has {{tools.reservations.list_for_customer.reservations.length}} reservations and the message names none of them." }
